+/* Gumbo policy entry point; never silently negotiate guest or weaker protection. */
+void gumbo_smb2_require_secure_session(struct smb2_context *context, int encrypted)
+{
+        context->gumbo_require_authenticated = 1;
+        context->gumbo_require_encryption = encrypted != 0;
+        smb2_set_security_mode(context, SMB2_NEGOTIATE_SIGNING_ENABLED | SMB2_NEGOTIATE_SIGNING_REQUIRED);
+        smb2_set_sign(context, 1);
+        if (encrypted) smb2_set_seal(context, 1);
+        smb2_set_version(context, encrypted ? SMB2_VERSION_ANY3 : SMB2_VERSION_ANY);
+}
+
+void gumbo_smb2_set_cancellation(struct smb2_context *context, int (*callback)(void *), void *data)
+{
+        context->gumbo_should_cancel = callback;
+        context->gumbo_cancellation_data = data;
+}
